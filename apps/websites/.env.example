# Webhook that receives contact-form submissions (e.g. a Google Apps Script
# endpoint, same shape as apps/portfolio's — reuse that URL or point to a
# separate one so leads from this site are easy to tell apart).
CONTACT_WEBHOOK_URL=

# WhatsApp number for the "Message on WhatsApp" button, digits only with
# country code, no symbols (e.g. 5511999999999). Placeholder until set.
NEXT_PUBLIC_WHATSAPP_NUMBER=5500000000000
