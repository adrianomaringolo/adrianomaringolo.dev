# Umami Cloud website ID (https://cloud.umami.is) — leave empty to disable tracking.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Keystatic (admin de /bookmarks em modo GitHub). Sem elas, /keystatic é 404 em produção.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Use "github" para testar o modo GitHub no dev (o padrão no dev é salvar no disco).
NEXT_PUBLIC_KEYSTATIC_STORAGE=
